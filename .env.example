# Salin file ini menjadi .env lalu isi nilainya. Jangan commit .env.

# Database development. Buat database & user PostgreSQL sendiri.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/wedding_planner"

# Database KHUSUS integration & E2E test. WAJIB berbeda dari DATABASE_URL:
# test membuat dan menghapus data di database ini.
DATABASE_URL_TEST="postgresql://USER:PASSWORD@localhost:5432/wedding_planner_test"

# URL publik aplikasi. Dipakai untuk membuat tautan (mis. reset password),
# bukan header Host dari request.
APP_URL="http://localhost:3000"

# Pengiriman email. Saat ini hanya "file": email ditulis sebagai JSON ke MAIL_FILE_DIR
# (khusus development). Provider email produksi belum dipilih.
MAIL_DRIVER="file"
MAIL_FILE_DIR=".data/mail"

# Penyimpanan gambar undangan. Saat ini hanya "file": byte gambar disimpan di MEDIA_FILE_DIR,
# metadata tetap di database. Object storage (S3/R2) bisa ditambahkan di belakang interface yang sama.
MEDIA_DRIVER="file"
MEDIA_FILE_DIR=".data/media"
