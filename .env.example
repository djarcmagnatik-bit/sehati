# Salin file ini menjadi .env lalu isi nilainya. Jangan commit .env.

# Database development. Buat database & user PostgreSQL sendiri.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/wedding_planner"

# Database KHUSUS integration & E2E test. WAJIB berbeda dari DATABASE_URL:
# test membuat dan menghapus data di database ini.
DATABASE_URL_TEST="postgresql://USER:PASSWORD@localhost:5432/wedding_planner_test"

# URL publik aplikasi. Dipakai untuk membuat tautan (mis. reset password),
# bukan header Host dari request.
APP_URL="http://localhost:3000"

# Pengiriman email. Saat ini hanya "file": email ditulis sebagai JSON ke MAIL_FILE_DIR
# (khusus development). Provider email produksi belum dipilih.
MAIL_DRIVER="file"
MAIL_FILE_DIR=".data/mail"

# Penyimpanan gambar undangan. Saat ini hanya "file": byte gambar disimpan di MEDIA_FILE_DIR,
# metadata tetap di database. Object storage (S3/R2) bisa ditambahkan di belakang interface yang sama.
MEDIA_DRIVER="file"
MEDIA_FILE_DIR=".data/media"

# Pembayaran. "sandbox" mensimulasikan halaman pembayaran di aplikasi ini (development & tes),
# "midtrans" memakai Midtrans Snap. Konfirmasi pembayaran SELALU lewat webhook.
PAYMENT_PROVIDER="sandbox"
# Minimal 16 karakter; menandatangani webhook sandbox.
PAYMENT_SANDBOX_SECRET="ganti-dengan-string-acak-panjang"
# Sandbox tidak boleh aktif di produksi kecuali disengaja (hanya untuk E2E).
ALLOW_SANDBOX_PAYMENTS="false"
# Midtrans (isi bila PAYMENT_PROVIDER="midtrans"). Webhook: {APP_URL}/api/payments/webhook/midtrans
MIDTRANS_SERVER_KEY=""
MIDTRANS_IS_PRODUCTION="false"

# Background jobs (notifikasi, pengingat). Jalankan "pnpm worker" sebagai proses terpisah.
# Tanpa worker permanen: isi secret (min. 32 karakter) lalu panggil POST {APP_URL}/api/jobs/run
# dengan header "Authorization: Bearer <secret>" dari scheduler (mis. tiap 5 menit). Kosong = endpoint mati.
JOBS_CRON_SECRET=""

# Jumlah reverse proxy tepercaya di depan aplikasi (nginx, load balancer) yang menambahkan
# X-Forwarded-For. Dipakai untuk membaca IP klien pada rate limit; nilai dari klien diabaikan.
TRUSTED_PROXY_COUNT="1"
