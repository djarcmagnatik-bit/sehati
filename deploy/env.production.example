# Copy to /opt/sehati/.env on the server, then: chmod 600 .env
# Generate secrets ON THE SERVER, e.g.  openssl rand -hex 32   (hex: safe inside URLs)
# Never commit the real file or paste it into chats.

# ─── Images (only when pulling from a registry; leave commented when building on the server) ───
# SEHATI_APP_IMAGE=ghcr.io/<owner>/sehati-app:latest
# SEHATI_TOOLS_IMAGE=ghcr.io/<owner>/sehati-tools:latest

# ─── Database (container "db"; DATABASE_URL is built from this in docker-compose.yml) ───
POSTGRES_PASSWORD=

# ─── App ───
APP_URL=https://sehati.wuzzgate.my.id
# docker-compose.yml sets TRUSTED_PROXY_COUNT=1 (Caddy).

# Email (cPanel mailbox; see docs/email.md)
MAIL_DRIVER=smtp
SMTP_HOST=mail.wuzzgate.my.id
SMTP_PORT=465
SMTP_USER=sehati@wuzzgate.my.id
SMTP_PASSWORD=
MAIL_FROM=Sehati <sehati@wuzzgate.my.id>

# Payments. Without a key, checkout shows "payment unavailable"; nothing is sold by accident.
PAYMENT_PROVIDER=midtrans
MIDTRANS_SERVER_KEY=
MIDTRANS_IS_PRODUCTION=false
ALLOW_SANDBOX_PAYMENTS=false

# Background jobs: the "cron" container calls /api/jobs/run with this (min. 32 characters).
JOBS_CRON_SECRET=

# Optional with one instance built from one image; see docs/deploy-aws.md.
# NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=
