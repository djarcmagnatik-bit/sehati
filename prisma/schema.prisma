// Conventions:
// - Tables/columns are snake_case in PostgreSQL (@@map / @map).
// - Primary keys are UUIDs; sequential IDs are never exposed.
// - Money is stored as BIGINT whole rupiah (IDR has no minor unit in practice). Never float.
// - Calendar dates (wedding date, task deadlines) are DATE columns, interpreted in weddings.time_zone.
// - Every private planning entity belongs to a wedding (wedding_id), never directly to a user.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
}

enum WeddingMemberRole {
  OWNER
  PARTNER
}

enum WeddingStatus {
  PLANNING
  COMPLETED
  ARCHIVED
}

enum CoupleDisplayFormat {
  BRIDE_GROOM
  GROOM_BRIDE
  CUSTOM
}

/// Declaration order matters: PostgreSQL sorts enums by it (used for "priority desc").
enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum TaskSource {
  TEMPLATE
  CUSTOM
}

enum PartnerInvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
  REVOKED
}

enum PaymentMethod {
  BANK_TRANSFER
  CASH
  E_WALLET
  CARD
  OTHER
}

enum VendorResearchStatus {
  RESEARCHING
  CONTACTED
  MEETING
  SHORTLISTED
  REJECTED
  SELECTED
}

enum GuestInvitationStatus {
  NOT_SENT
  SENT
  OPENED
  FOLLOW_UP
}

enum InvitationStatus {
  DRAFT
  PUBLISHED
}

/// Declaration order is the default section order on a new invitation.
enum InvitationSectionType {
  COVER
  COUPLE
  QUOTE
  EVENTS
  COUNTDOWN
  LOVE_STORY
  GALLERY
  LOCATION
  RSVP
  WISHES
  GIFT
  CLOSING
}

enum WishStatus {
  VISIBLE
  HIDDEN
}

enum GiftAccountType {
  BANK
  EWALLET
}

enum GuestRsvpStatus {
  PENDING
  ATTENDING
  MAYBE
  DECLINED
}

// ─── Phase 1: identity & workspace ───────────────────────────────────────────

model User {
  id           String   @id @default(uuid()) @db.Uuid
  name         String   @db.VarChar(80)
  /// Always stored trimmed + lowercased.
  email        String   @unique @db.VarChar(254)
  passwordHash String   @map("password_hash")
  role         UserRole @default(USER)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  sessions                   Session[]
  passwordResetTokens        PasswordResetToken[]
  memberships                WeddingMember[]
  createdWeddings            Wedding[]            @relation("WeddingCreatedBy")
  createdTasks               Task[]               @relation("TaskCreatedBy")
  sentPartnerInvitations     PartnerInvitation[]  @relation("InvitationInvitedBy")
  acceptedPartnerInvitations PartnerInvitation[]  @relation("InvitationAcceptedBy")
  activityLogs               ActivityLog[]
  createdExpenses            Expense[]            @relation("ExpenseCreatedBy")
  createdPayments            Payment[]            @relation("PaymentCreatedBy")
  createdVendorResearch      VendorResearch[]     @relation("VendorResearchCreatedBy")
  createdVendors             Vendor[]             @relation("VendorCreatedBy")
  createdGuests              Guest[]              @relation("GuestCreatedBy")
  createdGuestImports        GuestImportBatch[]   @relation("GuestImportCreatedBy")
  createdInvitations         Invitation[]         @relation("InvitationCreatedBy")
  uploadedMedia              MediaAsset[]         @relation("MediaUploadedBy")
  moderatedWishes            Wish[]               @relation("WishModeratedBy")

  @@map("users")
}

model Session {
  id         String   @id @default(uuid()) @db.Uuid
  /// SHA-256 of the random session token. The raw token only exists in the httpOnly cookie.
  tokenHash  String   @unique @map("token_hash") @db.VarChar(64)
  userId     String   @map("user_id") @db.Uuid
  remember   Boolean  @default(false)
  userAgent  String?  @map("user_agent") @db.VarChar(512)
  ipAddress  String?  @map("ip_address") @db.VarChar(64)
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(3)
  lastSeenAt DateTime @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  /// SHA-256 of the emailed token.
  tokenHash String    @unique @map("token_hash") @db.VarChar(64)
  userId    String    @map("user_id") @db.Uuid
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

/// Fixed-window counters for rate limiting / brute-force protection (no Redis required).
model RateLimitBucket {
  key             String   @id @db.VarChar(191)
  count           Int
  windowStartedAt DateTime @map("window_started_at") @db.Timestamptz(3)

  @@map("rate_limit_buckets")
}

/// Configurable wedding types (Akad saja, Akad + Resepsi, ...). Deactivate instead of deleting.
model EventType {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique @db.VarChar(50)
  name        String   @db.VarChar(100)
  description String?  @db.VarChar(255)
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  weddings      Wedding[]
  taskTemplates TaskTemplateEventType[]

  @@map("event_types")
}

/// Configurable marriage process / jalur nikah (KUA, pencatatan sipil, ...).
model MarriageProcess {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique @db.VarChar(50)
  name        String   @db.VarChar(100)
  description String?  @db.VarChar(255)
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  weddings      Wedding[]
  taskTemplates TaskTemplateMarriageProcess[]

  @@map("marriage_processes")
}

model Wedding {
  id                       String              @id @default(uuid()) @db.Uuid
  brideName                String              @map("bride_name") @db.VarChar(80)
  groomName                String              @map("groom_name") @db.VarChar(80)
  /// Name of the partner given during onboarding, before the partner account joins.
  partnerName              String?             @map("partner_name") @db.VarChar(80)
  coupleDisplayFormat      CoupleDisplayFormat @default(BRIDE_GROOM) @map("couple_display_format")
  customDisplayName        String?             @map("custom_display_name") @db.VarChar(120)
  weddingDate              DateTime            @map("wedding_date") @db.Date
  engagementDate           DateTime?           @map("engagement_date") @db.Date
  receptionDate            DateTime?           @map("reception_date") @db.Date
  timeZone                 String              @default("Asia/Jakarta") @map("time_zone") @db.VarChar(64)
  eventTypeId              String?             @map("event_type_id") @db.Uuid
  marriageProcessId        String?             @map("marriage_process_id") @db.Uuid
  /// Whole rupiah. CHECK (target_budget >= 0) is added in the migration SQL.
  targetBudget             BigInt?             @map("target_budget")
  currency                 String              @default("IDR") @db.Char(3)
  /// Warn when a category's committed spend reaches this % of its allocation. CHECK 1..100.
  budgetWarningPercent     Int                 @default(80) @map("budget_warning_percent")
  status                   WeddingStatus       @default(PLANNING)
  coupleNote               String?             @map("couple_note") @db.VarChar(280)
  coupleNoteUpdatedAt      DateTime?           @map("couple_note_updated_at") @db.Timestamptz(3)
  /// Set once template tasks have been generated; guards against generating twice.
  checklistGeneratedAt     DateTime?           @map("checklist_generated_at") @db.Timestamptz(3)
  /// Set once default budget categories have been created.
  budgetInitializedAt      DateTime?           @map("budget_initialized_at") @db.Timestamptz(3)
  /// Set once default guest groups have been created.
  guestGroupsInitializedAt DateTime?           @map("guest_groups_initialized_at") @db.Timestamptz(3)
  createdById              String?             @map("created_by_id") @db.Uuid
  createdAt                DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt                DateTime?           @map("deleted_at") @db.Timestamptz(3)

  eventType          EventType?          @relation(fields: [eventTypeId], references: [id], onDelete: Restrict)
  marriageProcess    MarriageProcess?    @relation(fields: [marriageProcessId], references: [id], onDelete: Restrict)
  createdBy          User?               @relation("WeddingCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  members            WeddingMember[]
  tasks              Task[]
  partnerInvitations PartnerInvitation[]
  activityLogs       ActivityLog[]
  budgetCategories   BudgetCategory[]
  expenses           Expense[]
  payments           Payment[]
  vendorResearch     VendorResearch[]
  vendors            Vendor[]
  guestGroups        GuestGroup[]
  guests             Guest[]
  guestImportBatches GuestImportBatch[]
  invitation         Invitation?
  invitationSections InvitationSection[]
  weddingEvents      WeddingEvent[]
  loveStoryEntries   LoveStoryEntry[]
  galleryImages      GalleryImage[]
  giftAccounts       GiftAccount[]
  mediaAssets        MediaAsset[]
  rsvpSubmissions    RsvpSubmission[]
  wishes             Wish[]

  @@index([weddingDate])
  @@map("weddings")
}

/// Every private planning entity is scoped by wedding_id; access is granted through this table.
model WeddingMember {
  id          String            @id @default(uuid()) @db.Uuid
  weddingId   String            @map("wedding_id") @db.Uuid
  userId      String            @map("user_id") @db.Uuid
  role        WeddingMemberRole
  displayName String            @map("display_name") @db.VarChar(80)
  joinedAt    DateTime          @default(now()) @map("joined_at") @db.Timestamptz(3)

  wedding       Wedding @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  user          User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedTasks Task[]

  @@unique([weddingId, userId])
  @@index([userId])
  @@map("wedding_members")
}

// ─── Phase 2: checklist ──────────────────────────────────────────────────────

/// Admin-configurable task categories (Administrasi, Venue, Catering, ...).
model TaskCategory {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique @db.VarChar(50)
  name      String   @db.VarChar(100)
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  templates TaskTemplate[]
  tasks     Task[]

  @@map("task_categories")
}

/// Admin-configurable checklist templates. A template with no linked event types / marriage
/// processes applies to all of them.
model TaskTemplate {
  id                 String       @id @default(uuid()) @db.Uuid
  code               String       @unique @db.VarChar(80)
  title              String       @db.VarChar(160)
  description        String?      @db.VarChar(2000)
  categoryId         String       @map("category_id") @db.Uuid
  priority           TaskPriority @default(MEDIUM)
  /// Days relative to the wedding date: -180 = 180 days before, 7 = a week after.
  deadlineOffsetDays Int          @map("deadline_offset_days")
  sortOrder          Int          @default(0) @map("sort_order")
  isActive           Boolean      @default(true) @map("is_active")
  createdAt          DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  category          TaskCategory                  @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  eventTypes        TaskTemplateEventType[]
  marriageProcesses TaskTemplateMarriageProcess[]
  tasks             Task[]

  @@index([isActive])
  @@map("task_templates")
}

model TaskTemplateEventType {
  templateId  String @map("template_id") @db.Uuid
  eventTypeId String @map("event_type_id") @db.Uuid

  template  TaskTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  eventType EventType    @relation(fields: [eventTypeId], references: [id], onDelete: Cascade)

  @@id([templateId, eventTypeId])
  @@index([eventTypeId])
  @@map("task_template_event_types")
}

model TaskTemplateMarriageProcess {
  templateId        String @map("template_id") @db.Uuid
  marriageProcessId String @map("marriage_process_id") @db.Uuid

  template        TaskTemplate    @relation(fields: [templateId], references: [id], onDelete: Cascade)
  marriageProcess MarriageProcess @relation(fields: [marriageProcessId], references: [id], onDelete: Cascade)

  @@id([templateId, marriageProcessId])
  @@index([marriageProcessId])
  @@map("task_template_marriage_processes")
}

model Task {
  id                 String       @id @default(uuid()) @db.Uuid
  weddingId          String       @map("wedding_id") @db.Uuid
  title              String       @db.VarChar(160)
  description        String?      @db.VarChar(2000)
  categoryId         String       @map("category_id") @db.Uuid
  dueDate            DateTime?    @map("due_date") @db.Date
  status             TaskStatus   @default(TODO)
  priority           TaskPriority @default(MEDIUM)
  assigneeMemberId   String?      @map("assignee_member_id") @db.Uuid
  source             TaskSource
  templateId         String?      @map("template_id") @db.Uuid
  /// Offset copied from the template at generation time, so later template edits never
  /// silently move existing deadlines.
  templateOffsetDays Int?         @map("template_offset_days")
  /// True once a person changes the deadline; recalculation never overwrites it.
  dueDateManuallySet Boolean      @default(false) @map("due_date_manually_set")
  completedAt        DateTime?    @map("completed_at") @db.Timestamptz(3)
  createdById        String?      @map("created_by_id") @db.Uuid
  createdAt          DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  wedding   Wedding        @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  category  TaskCategory   @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  assignee  WeddingMember? @relation(fields: [assigneeMemberId], references: [id], onDelete: SetNull)
  template  TaskTemplate?  @relation(fields: [templateId], references: [id], onDelete: SetNull)
  createdBy User?          @relation("TaskCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  /// One task per template per wedding (NULL template_id = custom tasks, unconstrained).
  @@unique([weddingId, templateId])
  @@index([weddingId, status, dueDate])
  @@index([weddingId, categoryId])
  @@index([assigneeMemberId])
  @@map("tasks")
}

// ─── Phase 3: couple collaboration ───────────────────────────────────────────

model PartnerInvitation {
  id           String                  @id @default(uuid()) @db.Uuid
  weddingId    String                  @map("wedding_id") @db.Uuid
  /// Invitee email, trimmed + lowercased. The accepting account must use this email.
  email        String                  @db.VarChar(254)
  /// SHA-256 of the token in the invitation link. The raw token is never stored.
  tokenHash    String                  @unique @map("token_hash") @db.VarChar(64)
  status       PartnerInvitationStatus @default(PENDING)
  invitedById  String?                 @map("invited_by_id") @db.Uuid
  acceptedById String?                 @map("accepted_by_id") @db.Uuid
  expiresAt    DateTime                @map("expires_at") @db.Timestamptz(3)
  respondedAt  DateTime?               @map("responded_at") @db.Timestamptz(3)
  createdAt    DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)

  wedding    Wedding @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  invitedBy  User?   @relation("InvitationInvitedBy", fields: [invitedById], references: [id], onDelete: SetNull)
  acceptedBy User?   @relation("InvitationAcceptedBy", fields: [acceptedById], references: [id], onDelete: SetNull)

  @@index([weddingId, status])
  @@map("partner_invitations")
}

/// Collaborative activity feed. Metadata holds small, non-secret context only.
model ActivityLog {
  id         String   @id @default(uuid()) @db.Uuid
  weddingId  String   @map("wedding_id") @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  /// Display name at the time of the action (kept if the member later leaves).
  actorName  String   @map("actor_name") @db.VarChar(80)
  action     String   @db.VarChar(64)
  entityType String   @map("entity_type") @db.VarChar(40)
  entityId   String?  @map("entity_id") @db.Uuid
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  wedding Wedding @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([weddingId, createdAt(sort: Desc)])
  @@index([userId])
  @@map("activity_logs")
}

// ─── Phase 4: budget, expenses & payments ────────────────────────────────────

/// Admin-configurable default budget categories, copied into each new workspace.
model BudgetCategoryTemplate {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique @db.VarChar(50)
  name      String   @db.VarChar(100)
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("budget_category_templates")
}

/// A couple's own budget category (customizable per workspace).
model BudgetCategory {
  id              String   @id @default(uuid()) @db.Uuid
  weddingId       String   @map("wedding_id") @db.Uuid
  name            String   @db.VarChar(100)
  /// Whole rupiah allocated to this category. CHECK (allocated_amount >= 0).
  allocatedAmount BigInt   @default(0) @map("allocated_amount")
  sortOrder       Int      @default(0) @map("sort_order")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  wedding  Wedding   @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  expenses Expense[]

  @@unique([weddingId, name])
  // Target of the composite FK that keeps an expense in its category's wedding.
  @@unique([id, weddingId])
  @@index([weddingId, sortOrder])
  @@map("budget_categories")
}

/// An obligation (e.g. a vendor contract). Payments settle it over time; outstanding is always
/// total_amount - SUM(payments.amount), computed from the rows, never stored.
model Expense {
  id          String    @id @default(uuid()) @db.Uuid
  weddingId   String    @map("wedding_id") @db.Uuid
  categoryId  String    @map("category_id") @db.Uuid
  /// Optional booked vendor this obligation belongs to (same wedding, enforced by composite FK).
  vendorId    String?   @map("vendor_id") @db.Uuid
  title       String    @db.VarChar(160)
  /// Whole rupiah. CHECK (total_amount > 0).
  totalAmount BigInt    @map("total_amount")
  dueDate     DateTime? @map("due_date") @db.Date
  notes       String?   @db.VarChar(2000)
  createdById String?   @map("created_by_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  wedding   Wedding        @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  category  BudgetCategory @relation(fields: [categoryId, weddingId], references: [id, weddingId], onDelete: NoAction)
  vendor    Vendor?        @relation(fields: [vendorId, weddingId], references: [id, weddingId], onDelete: NoAction)
  createdBy User?          @relation("ExpenseCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  payments  Payment[]

  // Target of the composite FK that keeps a payment in its expense's wedding.
  @@unique([id, weddingId])
  @@index([weddingId, categoryId])
  @@index([weddingId, dueDate])
  @@index([vendorId])
  @@map("expenses")
}

model Payment {
  id          String        @id @default(uuid()) @db.Uuid
  weddingId   String        @map("wedding_id") @db.Uuid
  expenseId   String        @map("expense_id") @db.Uuid
  /// Whole rupiah. CHECK (amount > 0).
  amount      BigInt
  paymentDate DateTime      @map("payment_date") @db.Date
  method      PaymentMethod
  reference   String?       @db.VarChar(120)
  notes       String?       @db.VarChar(1000)
  createdById String?       @map("created_by_id") @db.Uuid
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  wedding   Wedding @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  expense   Expense @relation(fields: [expenseId, weddingId], references: [id, weddingId], onDelete: NoAction)
  createdBy User?   @relation("PaymentCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([weddingId, paymentDate])
  @@index([expenseId])
  @@map("payments")
}

// ─── Phase 5: vendors ────────────────────────────────────────────────────────

/// Admin-configurable vendor categories. `budgetCategoryName` suggests the budget category for contracts.
model VendorCategory {
  id                 String   @id @default(uuid()) @db.Uuid
  code               String   @unique @db.VarChar(50)
  name               String   @db.VarChar(100)
  budgetCategoryName String?  @map("budget_category_name") @db.VarChar(100)
  sortOrder          Int      @default(0) @map("sort_order")
  isActive           Boolean  @default(true) @map("is_active")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  research VendorResearch[]
  vendors  Vendor[]

  @@map("vendor_categories")
}

/// A prospective vendor under consideration. Kept (with all notes) after it is booked.
model VendorResearch {
  id             String               @id @default(uuid()) @db.Uuid
  weddingId      String               @map("wedding_id") @db.Uuid
  categoryId     String               @map("category_id") @db.Uuid
  name           String               @db.VarChar(120)
  contactPerson  String?              @map("contact_person") @db.VarChar(120)
  whatsapp       String?              @db.VarChar(25)
  phone          String?              @db.VarChar(25)
  instagram      String?              @db.VarChar(30)
  /// Normalized http(s) URL only.
  website        String?              @db.VarChar(300)
  /// Whole rupiah. CHECK (estimated_price >= 0).
  estimatedPrice BigInt?              @map("estimated_price")
  packageName    String?              @map("package_name") @db.VarChar(160)
  location       String?              @db.VarChar(160)
  /// CHECK (rating BETWEEN 1 AND 5).
  rating         Int?
  pros           String?              @db.VarChar(1000)
  cons           String?              @db.VarChar(1000)
  notes          String?              @db.VarChar(2000)
  status         VendorResearchStatus @default(RESEARCHING)
  createdById    String?              @map("created_by_id") @db.Uuid
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  wedding      Wedding        @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  category     VendorCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  createdBy    User?          @relation("VendorResearchCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  bookedVendor Vendor?

  @@unique([id, weddingId])
  @@index([weddingId, status])
  @@index([weddingId, categoryId])
  @@map("vendor_research")
}

/// A booked vendor. Its money (contract / paid / outstanding) is derived from linked expenses.
model Vendor {
  id            String    @id @default(uuid()) @db.Uuid
  weddingId     String    @map("wedding_id") @db.Uuid
  categoryId    String    @map("category_id") @db.Uuid
  /// The research record this vendor was booked from (same wedding, enforced by composite FK).
  researchId    String?   @unique @map("research_id") @db.Uuid
  name          String    @db.VarChar(120)
  contactPerson String?   @map("contact_person") @db.VarChar(120)
  whatsapp      String?   @db.VarChar(25)
  phone         String?   @db.VarChar(25)
  instagram     String?   @db.VarChar(30)
  website       String?   @db.VarChar(300)
  packageName   String?   @map("package_name") @db.VarChar(160)
  bookingDate   DateTime? @map("booking_date") @db.Date
  /// Which event the vendor serves (free text until wedding events exist).
  eventLabel    String?   @map("event_label") @db.VarChar(120)
  notes         String?   @db.VarChar(2000)
  createdById   String?   @map("created_by_id") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  wedding   Wedding         @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  category  VendorCategory  @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  research  VendorResearch? @relation(fields: [researchId, weddingId], references: [id, weddingId], onDelete: NoAction)
  createdBy User?           @relation("VendorCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  expenses  Expense[]

  @@unique([id, weddingId])
  @@unique([researchId, weddingId])
  @@index([weddingId, categoryId])
  @@map("vendors")
}

// ─── Phase 6: guests ─────────────────────────────────────────────────────────

/// Admin-configurable default guest groups, copied into each new workspace.
model GuestGroupTemplate {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique @db.VarChar(50)
  name      String   @db.VarChar(80)
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("guest_group_templates")
}

model GuestGroup {
  id        String   @id @default(uuid()) @db.Uuid
  weddingId String   @map("wedding_id") @db.Uuid
  name      String   @db.VarChar(80)
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  wedding Wedding @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  guests  Guest[]

  @@unique([weddingId, name])
  @@unique([id, weddingId])
  @@index([weddingId, sortOrder])
  @@map("guest_groups")
}

/// One invitation. It can cover several people: invitation count != guest (seat) count.
model Guest {
  id                 String                @id @default(uuid()) @db.Uuid
  weddingId          String                @map("wedding_id") @db.Uuid
  groupId            String?               @map("group_id") @db.Uuid
  guestName          String                @map("guest_name") @db.VarChar(120)
  /// How the invitation is addressed, e.g. "Keluarga Bapak Ahmad".
  invitationName     String                @map("invitation_name") @db.VarChar(160)
  phone              String?               @db.VarChar(25)
  /// Digits with country code, for duplicate detection.
  phoneNormalized    String?               @map("phone_normalized") @db.VarChar(20)
  email              String?               @db.VarChar(254)
  address            String?               @db.VarChar(500)
  /// CHECK (seat_count BETWEEN 1 AND 50).
  seatCount          Int                   @default(1) @map("seat_count")
  invitationStatus   GuestInvitationStatus @default(NOT_SENT) @map("invitation_status")
  rsvpStatus         GuestRsvpStatus       @default(PENDING) @map("rsvp_status")
  /// CHECK: 0 <= attending_count <= seat_count, 0 unless ATTENDING/MAYBE, >= 1 when ATTENDING.
  attendingCount     Int                   @default(0) @map("attending_count")
  notes              String?               @db.VarChar(1000)
  /// Random, unguessable token for the personalized invitation link (/i/{token}).
  invitationToken    String                @unique @map("invitation_token") @db.VarChar(32)
  /// First time the personalized link was opened; drives the OPENED status.
  invitationOpenedAt DateTime?             @map("invitation_opened_at") @db.Timestamptz(3)
  importBatchId      String?               @map("import_batch_id") @db.Uuid
  createdById        String?               @map("created_by_id") @db.Uuid
  createdAt          DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)

  wedding         Wedding           @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  group           GuestGroup?       @relation(fields: [groupId, weddingId], references: [id, weddingId], onDelete: NoAction)
  importBatch     GuestImportBatch? @relation(fields: [importBatchId], references: [id], onDelete: SetNull)
  rsvpSubmissions RsvpSubmission[]
  wishes          Wish[]
  createdBy       User?             @relation("GuestCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([id, weddingId])
  @@index([weddingId, groupId])
  @@index([weddingId, rsvpStatus])
  @@index([weddingId, invitationStatus])
  @@index([weddingId, phoneNormalized])
  @@index([weddingId, invitationName])
  @@map("guests")
}

/// A parsed import file awaiting confirmation (preview → commit). Rows are re-validated on commit.
model GuestImportBatch {
  id            String    @id @default(uuid()) @db.Uuid
  weddingId     String    @map("wedding_id") @db.Uuid
  /// Sanitized, display-only original file name.
  fileName      String    @map("file_name") @db.VarChar(120)
  rowCount      Int       @map("row_count")
  rows          Json
  importedCount Int?      @map("imported_count")
  skippedCount  Int?      @map("skipped_count")
  committedAt   DateTime? @map("committed_at") @db.Timestamptz(3)
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz(3)
  createdById   String?   @map("created_by_id") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  wedding   Wedding @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  createdBy User?   @relation("GuestImportCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  guests    Guest[]

  @@index([weddingId, createdAt])
  @@map("guest_import_batches")
}

/// Public digital invitation for one wedding. Content lives in sections and the tables below,
/// so switching themes never touches it.
model Invitation {
  id                String           @id @default(uuid()) @db.Uuid
  weddingId         String           @unique @map("wedding_id") @db.Uuid
  /// Public URL segment (/undangan/{slug}). Lowercase a-z, 0-9 and "-" only.
  slug              String           @unique @db.VarChar(60)
  status            InvitationStatus @default(DRAFT)
  themeCode         String           @default("minimal") @map("theme_code") @db.VarChar(40)
  /// Optional per-invitation theme overrides, validated in app code.
  themeOptions      Json?            @map("theme_options")
  coverImageId      String?          @map("cover_image_id") @db.Uuid
  /// Fallback for "Kepada Yth." when a link carries no guest.
  defaultGuestLabel String?          @map("default_guest_label") @db.VarChar(120)
  /// Where physical gifts can be sent (shown in the gift section).
  giftAddress       String?          @map("gift_address") @db.VarChar(500)
  publishedAt       DateTime?        @map("published_at") @db.Timestamptz(3)
  createdById       String?          @map("created_by_id") @db.Uuid
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  wedding    Wedding     @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  coverImage MediaAsset? @relation("InvitationCover", fields: [coverImageId, weddingId], references: [id, weddingId], onDelete: NoAction, onUpdate: NoAction)
  createdBy  User?       @relation("InvitationCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  sections         InvitationSection[]
  loveStoryEntries LoveStoryEntry[]
  galleryImages    GalleryImage[]
  giftAccounts     GiftAccount[]

  @@unique([id, weddingId])
  @@index([status, slug])
  @@map("invitations")
}

/// One row per section type: whether it is shown, in which order, and its text content.
model InvitationSection {
  id           String                @id @default(uuid()) @db.Uuid
  invitationId String                @map("invitation_id") @db.Uuid
  weddingId    String                @map("wedding_id") @db.Uuid
  type         InvitationSectionType
  enabled      Boolean               @default(true)
  sortOrder    Int                   @map("sort_order")
  /// Section-specific fields, validated per type in app code. Never secrets.
  content      Json                  @default("{}")
  createdAt    DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)

  invitation Invitation @relation(fields: [invitationId, weddingId], references: [id, weddingId], onDelete: Cascade)
  wedding    Wedding    @relation(fields: [weddingId], references: [id], onDelete: Cascade)

  @@unique([invitationId, type])
  @@index([invitationId, sortOrder])
  @@map("invitation_sections")
}

/// Akad, resepsi, ngunduh mantu … Planning data that the invitation also displays.
model WeddingEvent {
  id        String   @id @default(uuid()) @db.Uuid
  weddingId String   @map("wedding_id") @db.Uuid
  name      String   @db.VarChar(80)
  eventDate DateTime @map("event_date") @db.Date
  /// Local wall-clock time in the wedding time zone, "HH:MM". CHECK enforces the format.
  startTime String?  @map("start_time") @db.VarChar(5)
  endTime   String?  @map("end_time") @db.VarChar(5)
  venueName String?  @map("venue_name") @db.VarChar(120)
  address   String?  @db.VarChar(500)
  /// WGS84. CHECK keeps latitude in -90..90 and longitude in -180..180.
  latitude  Decimal? @db.Decimal(9, 6)
  longitude Decimal? @db.Decimal(9, 6)
  /// Plain https link to a maps provider; no API key required.
  mapsUrl   String?  @map("maps_url") @db.VarChar(500)
  dressCode String?  @map("dress_code") @db.VarChar(120)
  notes     String?  @db.VarChar(1000)
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  wedding Wedding @relation(fields: [weddingId], references: [id], onDelete: Cascade)

  @@index([weddingId, sortOrder])
  @@map("wedding_events")
}

model LoveStoryEntry {
  id           String   @id @default(uuid()) @db.Uuid
  weddingId    String   @map("wedding_id") @db.Uuid
  invitationId String   @map("invitation_id") @db.Uuid
  title        String   @db.VarChar(120)
  /// Free text such as "2019" or "12 Februari 2023"; not every memory has an exact date.
  timeLabel    String?  @map("time_label") @db.VarChar(40)
  story        String   @db.VarChar(1000)
  imageId      String?  @map("image_id") @db.Uuid
  sortOrder    Int      @default(0) @map("sort_order")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  invitation Invitation  @relation(fields: [invitationId, weddingId], references: [id, weddingId], onDelete: Cascade)
  wedding    Wedding     @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  image      MediaAsset? @relation("LoveStoryImage", fields: [imageId, weddingId], references: [id, weddingId], onDelete: NoAction, onUpdate: NoAction)

  @@index([invitationId, sortOrder])
  @@map("love_story_entries")
}

model GalleryImage {
  id           String   @id @default(uuid()) @db.Uuid
  weddingId    String   @map("wedding_id") @db.Uuid
  invitationId String   @map("invitation_id") @db.Uuid
  assetId      String   @map("asset_id") @db.Uuid
  caption      String?  @db.VarChar(160)
  sortOrder    Int      @default(0) @map("sort_order")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  invitation Invitation @relation(fields: [invitationId, weddingId], references: [id, weddingId], onDelete: Cascade)
  wedding    Wedding    @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  asset      MediaAsset @relation("GalleryAsset", fields: [assetId, weddingId], references: [id, weddingId], onDelete: NoAction, onUpdate: NoAction)

  @@unique([invitationId, assetId])
  @@index([invitationId, sortOrder])
  @@map("gallery_images")
}

/// Display-only gift information. The app never claims money was received.
model GiftAccount {
  id            String          @id @default(uuid()) @db.Uuid
  weddingId     String          @map("wedding_id") @db.Uuid
  invitationId  String          @map("invitation_id") @db.Uuid
  type          GiftAccountType
  /// Bank or e-wallet name, e.g. "BCA" or "GoPay".
  providerName  String          @map("provider_name") @db.VarChar(60)
  accountNumber String          @map("account_number") @db.VarChar(40)
  accountHolder String          @map("account_holder") @db.VarChar(80)
  notes         String?         @db.VarChar(200)
  sortOrder     Int             @default(0) @map("sort_order")
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  invitation Invitation @relation(fields: [invitationId, weddingId], references: [id, weddingId], onDelete: Cascade)
  wedding    Wedding    @relation(fields: [weddingId], references: [id], onDelete: Cascade)

  @@index([invitationId, sortOrder])
  @@map("gift_accounts")
}

/// An uploaded image. Bytes live in the configured media store; only metadata is in the database.
model MediaAsset {
  id          String   @id @default(uuid()) @db.Uuid
  weddingId   String   @map("wedding_id") @db.Uuid
  /// Opaque key inside the media store; never a user-supplied path.
  storageKey  String   @unique @map("storage_key") @db.VarChar(200)
  /// Display-only original name.
  fileName    String   @map("file_name") @db.VarChar(120)
  mimeType    String   @map("mime_type") @db.VarChar(60)
  byteSize    Int      @map("byte_size")
  width       Int
  height      Int
  /// SHA-256 of the bytes, so the same image is stored once per wedding.
  checksum    String   @db.Char(64)
  createdById String?  @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  wedding   Wedding @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  createdBy User?   @relation("MediaUploadedBy", fields: [createdById], references: [id], onDelete: SetNull)

  invitationCovers Invitation[]     @relation("InvitationCover")
  loveStoryEntries LoveStoryEntry[] @relation("LoveStoryImage")
  galleryImages    GalleryImage[]   @relation("GalleryAsset")

  @@unique([id, weddingId])
  @@unique([weddingId, checksum])
  @@index([weddingId, createdAt])
  @@map("media_assets")
}

/// Every RSVP a guest sends, kept as history: the guest row holds the latest answer, this holds all of them.
model RsvpSubmission {
  id             String          @id @default(uuid()) @db.Uuid
  weddingId      String          @map("wedding_id") @db.Uuid
  guestId        String          @map("guest_id") @db.Uuid
  rsvpStatus     GuestRsvpStatus @map("rsvp_status")
  /// CHECK: 0 <= attending_count, and <= the guest's seat_count at submission time.
  attendingCount Int             @map("attending_count")
  /// Names the guest typed for the people coming, free text.
  attendeeNames  String?         @map("attendee_names") @db.VarChar(500)
  message        String?         @db.VarChar(1000)
  /// Coarse origin hint for abuse handling only; never shown to the couple.
  ipHash         String?         @map("ip_hash") @db.Char(64)
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  guest   Guest   @relation(fields: [guestId, weddingId], references: [id, weddingId], onDelete: Cascade)
  wedding Wedding @relation(fields: [weddingId], references: [id], onDelete: Cascade)

  @@index([weddingId, createdAt])
  @@index([guestId, createdAt])
  @@map("rsvp_submissions")
}

/// Public guestbook entry. Moderated by the couple: hide keeps it, delete removes it for good.
model Wish {
  id         String     @id @default(uuid()) @db.Uuid
  weddingId  String     @map("wedding_id") @db.Uuid
  /// Set when the wish arrives through a personalized guest link.
  guestId    String?    @map("guest_id") @db.Uuid
  name       String     @db.VarChar(80)
  message    String     @db.VarChar(1000)
  status     WishStatus @default(VISIBLE)
  ipHash     String?    @map("ip_hash") @db.Char(64)
  hiddenById String?    @map("hidden_by_id") @db.Uuid
  hiddenAt   DateTime?  @map("hidden_at") @db.Timestamptz(3)
  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)

  wedding  Wedding @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  /// NoAction: deleting a guest keeps their wish (guest_id is cleared in the same transaction).
  guest    Guest?  @relation(fields: [guestId, weddingId], references: [id, weddingId], onDelete: NoAction, onUpdate: NoAction)
  hiddenBy User?   @relation("WishModeratedBy", fields: [hiddenById], references: [id], onDelete: SetNull)

  @@index([weddingId, status, createdAt])
  @@map("wishes")
}
